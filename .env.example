# ─────────────────────────────────────────────────────────────────────────────
# Birthday Team Bot — Environment Configuration
#
# Copy this file to `.env` and fill in the real values.
#   cp .env.example .env
#
# NEVER commit your real `.env` file. It is already listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# Telegram bot token issued by @BotFather (REQUIRED)
BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated list of Telegram user IDs that are allowed to administer the
# bot (REQUIRED — at least one). Find your numeric ID via @userinfobot.
#   Example: ADMIN_TELEGRAM_IDS=11111111,22222222
ADMIN_TELEGRAM_IDS=11111111

# The corporate group chat ID where announcements are posted.
# Optional here — it can also be configured later from the in-bot admin panel.
# For supergroups this is a large negative number, e.g. -1001234567890.
GROUP_CHAT_ID=-1001234567890

# Application runtime mode: "production" | "development"
NODE_ENV=production

# Port for the lightweight health-check HTTP server (GET /health)
PORT=3000

# Default timezone for all scheduling and date formatting (IANA name)
TIMEZONE=Asia/Tashkent

# ─────────────────────────────────────────────────────────────────────────────
# Database
#
# When running the full stack with docker-compose, the host MUST be `postgres`
# (the compose service name), NOT `localhost`. The values below match the
# POSTGRES_* variables further down so the app and the database agree.
#
# For LOCAL development against a database on your own machine, change the host
# to `localhost`:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/birthday_bot?schema=public
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/birthday_bot?schema=public

# Credentials used by the bundled PostgreSQL container (docker-compose).
# Keep these in sync with DATABASE_URL above.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=birthday_bot

# ─────────────────────────────────────────────────────────────────────────────
# Optional tuning
# ─────────────────────────────────────────────────────────────────────────────

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Telegram bot mode: "polling" (default, recommended for Droplet) or "webhook"
BOT_MODE=polling

# Webhook settings — only used when BOT_MODE=webhook (optional, advanced)
# WEBHOOK_DOMAIN=https://bot.example.com
# WEBHOOK_PATH=/telegraf/secret-path
